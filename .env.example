# Variabili d'ambiente frontend (Vite).
# Copia questo file in .env e inserisci i valori reali.

# URL del progetto Supabase (senza /rest/v1)
VITE_SUPABASE_URL=https://foitfvhwtxwhztiqwqbe.supabase.co

# Chiave pubblica anon (browser-safe). NON inserire la service role.
VITE_SUPABASE_ANON_KEY=your-anon-key

# URL pubblico del deploy (senza slash finale).
# Usato per: redirect Auth, canonical, Open Graph, sitemap.
VITE_PUBLIC_SITE_URL=https://tennis-asiago.vercel.app
